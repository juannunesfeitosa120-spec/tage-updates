# Public GitHub repository used only to host update artifacts.
TAGGI_GITHUB_OWNER=your-github-user-or-organization
TAGGI_GITHUB_REPO=taggi-releases

# Administrative Supabase access used only by the release script/CI.
# Never prefix this key with VITE_ and never ship it with the application.
TAGGI_SUPABASE_URL=https://your-project.supabase.co
TAGGI_SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Windows code-signing certificate (recommended in CI secrets).
WIN_CSC_LINK=base64-or-secure-path-to-certificate
WIN_CSC_KEY_PASSWORD=certificate-password

# Publication credentials. GitHub Actions can use its scoped GITHUB_TOKEN.
GH_TOKEN=github-token-with-release-permission
