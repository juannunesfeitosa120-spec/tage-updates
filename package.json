{
  "name": "taggi-desktop",
  "productName": "Tage Beta",
  "version": "1.0.0",
  "buildNumber": 1,
  "taggiReleaseChannel": "beta",
  "description": "Contagens compartilhadas em tempo real para equipes.",
  "author": "Juan Nunes",
  "private": true,
  "main": "desktop/electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-desktop.mjs",
    "web:dev": "vinext dev",
    "build": "vinext build",
    "desktop:build": "vite build --config desktop/vite.config.ts",
    "desktop:package": "pnpm run build:test",
    "build:test": "node scripts/release.mjs build-test",
    "release:dry": "node scripts/release.mjs dry",
    "release:beta": "node scripts/release.mjs beta",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "promote:stable": "node scripts/release.mjs promote",
    "release:block": "node scripts/release.mjs block",
    "release:status": "node scripts/release.mjs status",
    "test": "pnpm run test:release",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run lint:release && pnpm run test:release && pnpm run typecheck && pnpm run desktop:build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "lint:release": "oxlint desktop scripts hooks/use-desktop-updates.ts lib/release-client.ts lib/taggi-media.ts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "electron-updater": "6.8.9",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "supabase": "2.116.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "com.taggi.desktop",
    "productName": "Tage Beta",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "desktop/electron/**/*",
      "public/taggi-app-icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/taggi-app-icon.png",
      "artifactName": "Tage-Beta-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tage Beta"
    }
  }
}
